# --- LLM configuration (all optional) -------------------------------------
# The agent works fully offline (heuristic router + template generation) when
# no LLM is configured. Set these to enable LLM tool-calling for routing,
# content generation and keyword classification.
#
# Supported providers (LLM_PROVIDER): openai | openrouter | vllm | ollama | lmstudio | openai_compatible | none
#
# OpenAI:
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
#
# OpenRouter (any model that supports tool calling, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-sonnet):
#   LLM_PROVIDER=openrouter
#   OPENROUTER_API_KEY=sk-or-...
#   LLM_MODEL=openai/gpt-4o-mini
#   # optional attribution: OPENROUTER_REFERER=https://your-site  OPENROUTER_APP_TITLE=workflow-agent
#
# vLLM (start it with tool calling enabled, e.g.
#   vllm serve <model> --enable-auto-tool-choice --tool-call-parser hermes):
#   LLM_PROVIDER=vllm
#   LLM_BASE_URL=http://localhost:8000/v1      # default
#   LLM_MODEL=                                   # optional: auto-discovered from the server if empty
#   VLLM_API_KEY=                                # only if you started vLLM with --api-key
#
# Ollama / LM Studio / any other OpenAI-compatible server:
#   LLM_PROVIDER=ollama                          # or lmstudio / openai_compatible
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.1
#
# Force offline mode:
#   LLM_PROVIDER=none
LLM_PROVIDER=none
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# --- Business thresholds (defaults shown) ----------------------------------
PRICE_DIFF_THRESHOLD_PCT=10
FAILURE_RATE_THRESHOLD_PCT=10
SLOW_WORKFLOW_THRESHOLD_MS=5000
SLOW_STEP_THRESHOLD_MS=2000
RESTOCK_TARGET_MULTIPLIER=2.0

# Where result files (CSV / markdown) and the execution log are written
# OUTPUT_DIR=outputs
# EXECUTION_LOG_FILE=logs/execution_log.csv

# Use bundled sample data when a request does not supply a file / product / task
ALLOW_SAMPLE_DEFAULTS=true
